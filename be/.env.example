# Chép file này thành .env rồi điền giá trị thật:
#   cp .env.example .env
# .env nằm trong .gitignore và phải giữ nguyên như vậy.

# Cổng server. Bỏ trống thì server.js dùng 5000.
# Nếu đổi, nhớ sửa VITE_API_URL trong fe/.env cho khớp.
PORT=3002

# Postgres cho môi trường phát triển.
DATABASE_URL="postgresql://user:password@localhost:5432/cms_ecommerce?schema=public"

# Postgres RIÊNG cho test. Bắt buộc phải là database khác DATABASE_URL:
# mỗi test chạy TRUNCATE toàn bộ bảng, trỏ nhầm vào DB dev là mất sạch dữ liệu.
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/cms_ecommerce_test?schema=public"

# Khoá ký JWT. Không có giá trị mặc định dự phòng trong code — thiếu biến này
# thì server không khởi động được (cố ý, xem QĐ-2 spec auth).
# Sinh một chuỗi ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Không bắt buộc. Dùng cho prisma/seed-admin.js khi không truyền tham số dòng lệnh:
#   node prisma/seed-admin.js <username> <email> <password>
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
